  "worker_implementations": {
    "hash-probe-worker.js": "importScripts('../../browser-prepare/vendor/md5.umd.js','../../browser-prepare/vendor/sha256.umd.js');\nself.onmessage=async({data})=>{\n try {\n  const sha=await hashwasm.createSHA256(),md5=await hashwasm.createMD5();sha.init();md5.init();\n  const r=data.file.stream().getReader(),step=256*1024**2;let total=0,next=step;\n  const started=performance.now();\n  for(;;){\n   const {done,value}=await r.read();if(done)break;\n   for(let offset=0;offset<value.length;){\n    const count=Math.min(value.length-offset,next-total),part=value.subarray(offset,offset+count);\n    sha.update(part);md5.update(part);offset+=count;total+=count;\n    if(total===next){\n     const sc=await hashwasm.createSHA256(),mc=await hashwasm.createMD5();sc.load(sha.save());mc.load(md5.save());\n     self.postMessage({bytes:total,sha256:sc.digest(),md5:mc.digest(),seconds:(performance.now()-started)/1000});next+=step;\n    }\n   }\n  }\n  self.postMessage({done:true,bytes:total,sha256:sha.digest(),md5:md5.digest(),seconds:(performance.now()-started)/1000});\n }catch(e){self.postMessage({error:String(e),stack:e.stack});}\n};\n",
    "intake-probe-worker.js": "import {loadTools,sha256} from '../../browser-prepare/classification-runtime.js';\nimport {traverseZstd} from '../../browser-prepare/classification-intake.js';\nimport {decodeObservation} from '../../browser-prepare/classification-las.js';\nself.onmessage=async({data})=>{\n try {\n  const read=async path=>new Uint8Array(await(await fetch('/'+path)).arrayBuffer());\n  const tools=await loadTools(read),plan=await(await fetch('/temp/classification/full-fixtures/firefox-inference-plan.json')).json();\n  const refs=new Map((await(await fetch('/temp/classification/tls-prefix-hashes.json')).json()).map(r=>[r.bytes,r]));\n  const original=tools.hashers.sha256;let archiveHash,clone,total=0,next=256*1024**2,calls=0,parts=[];\n  tools.hashers.sha256=async()=>{\n   const hash=await original();\n   if(calls++)return hash;\n   archiveHash=hash;clone=await original();\n   return {init:()=>hash.init(),update:bytes=>{\n    hash.update(bytes);total+=bytes.length;\n    if(total>=next){\n     clone.load(hash.save());const got=clone.digest(),reference=refs.get(total);\n     self.postMessage({bytes:total,chunk:bytes.length,sha256:got,match:reference?got===reference.sha256:null});next+=256*1024**2;\n     if(reference&&got!==reference.sha256)throw Error('PREFIX_MISMATCH');\n    }\n   },digest:()=>{const got=hash.digest();self.postMessage({archive_sha256:got});return got;}};\n  };\n  const asset=plan.archives.find(a=>a.name==='TLS.tar.zst'),observations=plan.observations.filter(o=>o.archive===asset.name);\n  const sink={start:async()=>{parts=[];},write:async bytes=>{parts.push(bytes.slice());},end:async observation=>{\n   const before=archiveHash.save();\n   const report=await decodeObservation(new Blob(parts),observation,tools.laz,async block=>{\n    const coords=new Uint8Array(block.points*24),view=new DataView(coords.buffer),raw=new DataView(block.bytes.buffer,block.bytes.byteOffset,block.bytes.length);\n    for(let i=0;i<block.points;i++)for(let a=0;a<3;a++)view.setFloat64(i*24+a*8,raw.getInt32(i*block.pointSize+a*4,true)*block.scales[a]+block.offsets[a],true);\n    await sha256(block.bytes);await sha256(coords);\n   },tools.hashers);\n   const after=archiveHash.save(),same=before.length===after.length&&before.every((v,i)=>v===after[i]);\n   self.postMessage({cloud:observation.path,archive_bytes:total,state_unchanged:same,report});\n   if(!same)throw Error('ARCHIVE_STATE_CHANGED_DURING_CLOUD');parts=[];\n  }};\n  const report=await traverseZstd(data.file.stream(),asset,observations,sink,tools.hashers);\n  self.postMessage({done:true,report});\n }catch(e){self.postMessage({error:String(e),stack:e.stack});}\n};\n"
  },

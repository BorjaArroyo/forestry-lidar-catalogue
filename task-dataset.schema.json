{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "task_ref": {
      "const": "task:instances"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "use": {
          "enum": [
            "training",
            "evaluation",
            "inference"
          ]
        },
        "variables": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "required",
              "optional",
              "off"
            ]
          }
        }
      },
      "required": [
        "use",
        "variables"
      ]
    },
    "task_requirements_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "variables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "identity_scope": {
      "const": "source-release-and-scene"
    },
    "partition_policy": {
      "const": "preserve-published"
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "partition": {
            "enum": [
              "dev",
              "train",
              "test"
            ]
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "pipeline_ref": {
            "type": "string",
            "minLength": 1
          },
          "plan": {
            "type": "object"
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "scene_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "path",
          "partition",
          "source_ref",
          "pipeline_ref",
          "plan",
          "manifest_sha256",
          "scene_ids"
        ]
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "task_ref",
    "request",
    "task_requirements_sha256",
    "variables",
    "identity_scope",
    "partition_policy",
    "packages",
    "limitations"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://borjaarroyo.github.io/forestry-lidar-catalogue/task-dataset.schema.json",
  "title": "Task dataset folder index"
}

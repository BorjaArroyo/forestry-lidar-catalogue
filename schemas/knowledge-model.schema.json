{
  "type": "object",
  "properties": {
    "$schema": {
      "enum": [
        "knowledge-model.schema.json"
      ]
    },
    "schema_version": {
      "enum": [
        "1.4"
      ]
    },
    "nodes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.:-]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/node"
      },
      "minProperties": 1
    },
    "edges": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.:-]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "required": [
    "$schema",
    "schema_version",
    "nodes",
    "edges"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canopy curated knowledge graph",
  "$defs": {
    "evidenceUse": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ref": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.:-]+$"
        }
      },
      "required": [
        "label",
        "evidence_ref"
      ],
      "additionalProperties": false
    },
    "sourceFact": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ref": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.:-]+$"
        }
      },
      "required": [
        "label",
        "text",
        "evidence_ref"
      ],
      "additionalProperties": false
    },
    "fieldSchema": {
      "type": "object",
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "files": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "fields",
        "files"
      ],
      "additionalProperties": false
    },
    "observationSnapshot": {
      "type": "object",
      "properties": {
        "source_metadata_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "cloud_count": {
          "type": "integer",
          "minimum": 0
        },
        "points": {
          "type": "integer",
          "minimum": 0
        },
        "schemas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fieldSchema"
          }
        }
      },
      "required": [
        "source_metadata_sha256",
        "cloud_count",
        "points",
        "schemas"
      ],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "reviewed_at": {
          "type": "string",
          "format": "date"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "observation_unit": {
          "type": "string",
          "minLength": 1
        },
        "published_protocol": {
          "type": "string",
          "minLength": 1
        },
        "source_facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceFact"
          },
          "minItems": 1
        },
        "local_observations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "observations_snapshot": {
          "$ref": "#/$defs/observationSnapshot"
        }
      },
      "required": [
        "reviewed_at",
        "scope",
        "observation_unit",
        "published_protocol",
        "source_facts",
        "local_observations",
        "open_questions",
        "observations_snapshot"
      ],
      "additionalProperties": false
    },
    "discovery": {
      "type": "object",
      "properties": {
        "unit": {
          "enum": [
            "plots",
            "mixed",
            "trees"
          ]
        },
        "unit_label": {
          "type": "string",
          "minLength": 1
        },
        "instance_reference": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "plots",
                "trees",
                "none"
              ]
            },
            "label": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "label"
          ],
          "additionalProperties": false
        },
        "coverage": {
          "type": "string",
          "minLength": 1
        },
        "limitation": {
          "type": "string",
          "minLength": 1
        },
        "preparation": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "tbd",
                "blocked",
                "ready"
              ]
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "detail": {
              "type": "string",
              "minLength": 1
            },
            "limited_reference_copy": {
              "type": "boolean"
            }
          },
          "required": [
            "status",
            "label",
            "detail",
            "limited_reference_copy"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "unit",
        "unit_label",
        "instance_reference",
        "coverage",
        "limitation",
        "preparation"
      ],
      "additionalProperties": false
    },
    "sourceProfile": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "short": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "geography": {
          "type": "string",
          "minLength": 1
        },
        "scanner": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "labels": {
          "type": "string",
          "minLength": 1
        },
        "class_semantics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              },
              "term": {
                "type": "string",
                "minLength": 1
              },
              "evidence_ref": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.:-]+$"
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "code",
              "term",
              "evidence_ref"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "readiness": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "correction": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "string",
          "minLength": 1
        },
        "study_context": {
          "type": "string",
          "minLength": 1
        },
        "modalities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "spectral": {
          "type": "boolean"
        },
        "review": {
          "$ref": "#/$defs/review"
        },
        "discovery": {
          "$ref": "#/$defs/discovery"
        },
        "classification": {
          "type": "object",
          "properties": {
            "source_ref": {
              "type": "string"
            },
            "trees": {
              "type": "integer"
            },
            "observations": {
              "type": "integer"
            },
            "genus_only": {
              "type": "integer"
            },
            "partitions": {
              "type": "object"
            },
            "duplicate_cloud_groups_crossing_partitions": {
              "type": "integer"
            },
            "metadata_path": {
              "type": "string"
            }
          },
          "required": [
            "source_ref",
            "trees",
            "observations",
            "genus_only",
            "partitions",
            "metadata_path"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "short",
        "domain",
        "geography",
        "scanner",
        "kind",
        "labels",
        "role",
        "readiness",
        "note",
        "correction",
        "provenance",
        "study_context",
        "modalities",
        "spectral",
        "review",
        "discovery"
      ],
      "additionalProperties": false
    },
    "sourceRelease": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "source_release"
          ]
        },
        "data": {
          "type": "object",
          "properties": {
            "record_id": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "profile": {
              "$ref": "#/$defs/sourceProfile"
            },
            "source_ref": {
              "type": "string",
              "pattern": "^(zenodo:[1-9][0-9]*|grodata:[1-9][0-9]*:[0-9]+\\.[0-9]+)$"
            }
          },
          "required": [
            "record_id",
            "profile"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "data"
      ],
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "task"
          ]
        },
        "data": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "visible": {
              "type": "boolean"
            },
            "status": {
              "enum": [
                "work_in_progress",
                "tbd"
              ]
            },
            "order": {
              "type": "integer",
              "minimum": 0
            },
            "requirements": {
              "type": "object",
              "properties": {
                "variables": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]*$"
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1
                      },
                      "purpose": {
                        "enum": [
                          "geometry",
                          "reference",
                          "measurement"
                        ]
                      },
                      "default": {
                        "enum": [
                          "required",
                          "optional",
                          "off"
                        ]
                      },
                      "detail": {
                        "type": "string",
                        "minLength": 1
                      },
                      "output_fields": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string",
                              "minLength": 1
                            },
                            "dtypes": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "minLength": 1
                              },
                              "minItems": 1,
                              "uniqueItems": true
                            },
                            "shape": {
                              "type": "array",
                              "items": {
                                "type": [
                                  "string",
                                  "integer"
                                ]
                              }
                            }
                          },
                          "required": [
                            "name",
                            "dtypes",
                            "shape"
                          ],
                          "additionalProperties": false
                        },
                        "minItems": 1
                      },
                      "quantity": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "minimum_channels": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "key",
                      "label",
                      "purpose",
                      "default",
                      "detail",
                      "output_fields",
                      "quantity",
                      "minimum_channels"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                },
                "uses": {
                  "type": "object",
                  "properties": {
                    "training": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "required_variables": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "minItems": 1,
                          "uniqueItems": true
                        },
                        "allowed_partitions": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "minItems": 1,
                          "uniqueItems": true
                        },
                        "detail": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "label",
                        "required_variables",
                        "allowed_partitions",
                        "detail"
                      ],
                      "additionalProperties": false
                    },
                    "evaluation": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "required_variables": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "minItems": 1,
                          "uniqueItems": true
                        },
                        "allowed_partitions": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "minItems": 1,
                          "uniqueItems": true
                        },
                        "detail": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "label",
                        "required_variables",
                        "allowed_partitions",
                        "detail"
                      ],
                      "additionalProperties": false
                    },
                    "inference": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "required_variables": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "minItems": 1,
                          "uniqueItems": true
                        },
                        "allowed_partitions": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "minItems": 1,
                          "uniqueItems": true
                        },
                        "detail": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "label",
                        "required_variables",
                        "allowed_partitions",
                        "detail"
                      ],
                      "additionalProperties": false
                    },
                    "validation": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "required_variables": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "minItems": 1,
                          "uniqueItems": true
                        },
                        "allowed_partitions": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "minItems": 1,
                          "uniqueItems": true
                        },
                        "detail": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "label",
                        "required_variables",
                        "allowed_partitions",
                        "detail"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "training",
                    "evaluation",
                    "inference"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "variables",
                "uses"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "key",
            "name",
            "title",
            "description",
            "visible",
            "status",
            "order"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "data"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "evidence"
          ]
        },
        "data": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "url"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "local": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "local"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "type",
        "data"
      ],
      "additionalProperties": false
    },
    "node": {
      "oneOf": [
        {
          "$ref": "#/$defs/sourceRelease"
        },
        {
          "$ref": "#/$defs/task"
        },
        {
          "$ref": "#/$defs/evidence"
        },
        {
          "$ref": "#/$defs/dataContract"
        },
        {
          "$ref": "#/$defs/transformation"
        },
        {
          "$ref": "#/$defs/pipelineSpec"
        },
        {
          "$ref": "#/$defs/coordinateFrame"
        },
        {
          "$ref": "#/$defs/measurementChannel"
        }
      ]
    },
    "taskSupport": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "task_support"
          ]
        },
        "source": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.:-]+$"
        },
        "target": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.:-]+$"
        },
        "data": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "documented",
                "partial",
                "not_documented",
                "unsupported",
                "derived_only"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "listing_order": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "conditional_order": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          "required": [
            "status",
            "reason",
            "listing_order",
            "conditional_order"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "source",
        "target",
        "data"
      ],
      "additionalProperties": false
    },
    "relationshipContract": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "legacy_code_inspection",
            "tested_label_helper",
            "blocked",
            "dependency_evidence",
            "review_required"
          ]
        },
        "input": {
          "type": "string",
          "minLength": 1
        },
        "output": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "preserved": {
          "type": "string",
          "minLength": 1
        },
        "target_scope": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "input",
        "output",
        "steps",
        "preconditions",
        "preserved",
        "target_scope"
      ],
      "additionalProperties": false
    },
    "datasetRelationship": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "dataset_relationship"
          ]
        },
        "source": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.:-]+$"
        },
        "target": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.:-]+$"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "task_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.:-]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "data": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "transform",
                "partial",
                "blocked",
                "shared",
                "unknown"
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "rule": {
              "type": "string",
              "minLength": 1
            },
            "loss": {
              "type": "string",
              "minLength": 1
            },
            "evidence_status": {
              "type": "string",
              "minLength": 1
            },
            "implementation": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/evidenceUse"
              },
              "minItems": 1
            },
            "contract": {
              "$ref": "#/$defs/relationshipContract"
            }
          },
          "required": [
            "kind",
            "name",
            "rule",
            "loss",
            "evidence_status",
            "implementation",
            "evidence",
            "contract"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "source",
        "target",
        "order",
        "task_refs",
        "data"
      ],
      "additionalProperties": false
    },
    "edge": {
      "oneOf": [
        {
          "$ref": "#/$defs/taskSupport"
        },
        {
          "$ref": "#/$defs/datasetRelationship"
        },
        {
          "$ref": "#/$defs/dataFlow"
        }
      ]
    },
    "contractField": {
      "type": "object",

{
  "type": "object",
  "required": [
    "schema_version",
    "pipeline",
    "package_sha256",
    "source",
    "policy",
    "scenes",
    "native_schemas",
    "unmatched_split_rows",
    "scope",
    "geographic_independence"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "pipeline": {
      "enum": [
        "for-instance-plot-instances:1.0.0",
        "fgi-emit-plot-instances:1.0.0"
      ]
    },
    "package_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object"
    },
    "policy": {
      "type": "object"
    },
    "scenes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scene"
      },
      "minItems": 1
    },
    "native_schemas": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[0-9a-f]{20}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/native_schema"
      }
    },
    "unmatched_split_rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/split_row"
      }
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "geographic_independence": {
      "type": "string",
      "minLength": 1
    },
    "selection": {
      "type": "object",
      "required": [
        "kind",
        "paths",
        "available_plots",
        "archive_verification"
      ],
      "properties": {
        "kind": {
          "const": "explicit-plots"
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "available_plots": {
          "type": "integer",
          "minimum": 1
        },
        "archive_verification": {
          "const": "Not performed by this selection; each selected LAS is SHA256 verified against the reviewed release"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://borjaarroyo.github.io/forestry-lidar-catalogue/task-package.schema.json",
  "title": "Tree-instance task package (complete release or explicit selection)",
  "description": "Closed source-specific task profiles. Native class codes and spectral policies remain release-specific.",
  "$defs": {
    "chunk": {
      "type": "object",
      "required": [
        "path",
        "points",
        "offset",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "points": {
          "type": "integer",
          "minimum": 1,
          "maximum": 250000
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "split_row": {
      "type": "object",
      "required": [
        "path",
        "folder",
        "split"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "folder": {
          "type": "string",
          "minLength": 1
        },
        "split": {
          "enum": [
            "dev",
            "test"
          ]
        }
      },
      "additionalProperties": false
    },
    "attempt": {
      "type": "object",
      "required": [
        "size_bytes",
        "stream_sha256",
        "snapshot_sha256"
      ],
      "properties": {
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "stream_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "native_schema": {
      "type": "object",
      "required": [
        "las_version",
        "point_format",
        "stored_dtype",
        "dimensions"
      ],
      "properties": {
        "las_version": {
          "enum": [
            "1.0",
            "1.1",
            "1.2",
            "1.3",
            "1.4"
          ]
        },
        "point_format": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "stored_dtype": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                },
                "minItems": 1
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 3
          },
          "minItems": 1
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "dtype",
              "bits",
              "description",
              "scales",
              "offsets"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "dtype": {
                "type": "string",
                "minLength": 1
              },
              "bits": {
                "type": "integer",
                "minimum": 1
              },
              "description": {
                "type": "string"
              },
              "scales": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  }
                ]
              },
              "offsets": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  }
                ]
              }
            },
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "scene": {
      "type": "object",
      "required": [
        "id",
        "path",
        "sha256",
        "points",
        "published_split",
        "crs",
        "scales",
        "offsets",
        "chunks",
        "class_counts",
        "unknown_points",
        "background_points",
        "tree_points",
        "input_snapshot_attempts",
        "native_schema_ref"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(8287792|19351234)-[0-9a-f]{20}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "points": {
          "type": "integer",
          "minimum": 0
        },
        "published_split": {
          "enum": [
            "dev",
            "train",
            "test"
          ]
        },
        "crs": {
          "type": [
            "string",
            "null"
          ]
        },
        "scales": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minItems": 3,
          "maxItems": 3
        },
        "offsets": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "chunks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/chunk"
          }
        },
        "class_counts": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 6,
          "maxItems": 7
        },
        "unknown_points": {
          "type": "integer",
          "minimum": 0
        },
        "background_points": {
          "type": "integer",
          "minimum": 0
        },
        "tree_points": {
          "type": "integer",
          "minimum": 0
        },
        "input_snapshot_attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attempt"
          },
          "minItems": 1,
          "maxItems": 3
        },
        "native_schema_ref": {
          "type": "string",
          "pattern": "^[0-9a-f]{20}$"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.1.0"
          }
        }
      },
      "then": {
        "required": [
          "selection"
        ]
      },
      "else": {
        "not": {
          "required": [
            "selection"
          ]
        }
      }
    }
  ],
  "oneOf": [
    {
      "properties": {
        "pipeline": {
          "const": "for-instance-plot-instances:1.0.0"
        },
        "source": {
          "type": "object",
          "required": [
            "record_id",
            "archive_sha256",
            "provider_checksum"
          ],
          "properties": {
            "record_id": {
              "const": 8287792
            },
            "archive_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "provider_checksum": {
              "type": "string",
              "pattern": "^md5:[0-9a-f]{32}$"
            }
          },
          "additionalProperties": false
        },
        "policy": {
          "type": "object",
          "required": [
            "id",
            "unknown",
            "background",
            "tree",
            "rules",
            "instance_valid",
            "preserved",
            "limitations",
            "evidence"
          ],
          "properties": {
            "id": {
              "const": "for-instance-conservative-reference:1.0.0"
            },
            "unknown": {
              "const": -1
            },
            "background": {
              "const": 0
            },
            "tree": {
              "type": "string",
              "minLength": 1
            },
            "rules": {
              "type": "object",
              "required": [
                "0,1,3",
                "2",
                "4,5,6"
              ],
              "properties": {
                "0,1,3": {
                  "type": "string",
                  "minLength": 1
                },
                "2": {
                  "type": "string",
                  "minLength": 1
                },
                "4,5,6": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "instance_valid": {
              "const": "instance >= 0"
            },
            "preserved": {
              "type": "string",
              "minLength": 1
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        "scenes": {
          "items": {
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^8287792-[0-9a-f]{20}$"
              },
              "published_split": {
                "enum": [
                  "dev",
                  "test"
                ]
              },
              "class_counts": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 7,
                "maxItems": 7
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "pipeline": {
          "const": "fgi-emit-plot-instances:1.0.0"
        },
        "schema_version": {
          "const": "1.1.0"
        },
        "policy": {
          "const": {
            "id": "fgi-emit-conservative-reference:1.0.0",
            "unknown": -1,
            "background": 0,
            "tree": "Positive native plot-local tree_index, unchanged",
            "rules": {
              "0,5": "Unknown, including broad other/understory and out-of-plot points",
              "2,3,4": "Known non-tree building/vehicle/pole background, not terrain labels",
              "1": "Positive tree_index is retained; zero remains unknown"
            },
            "instance_valid": "instance >= 0",
            "features": {
              "fields": [
                "reflectance_1",
                "reflectance_2",
                "reflectance_3"
              ],
              "wavelengths_nm": [
                1550,
                905,
                532
              ],
              "valid": "isfinite(native_value) and native_value != -9999",
              "units": "Unknown; no cross-source calibration, rescaling or imputation",
              "association": "Provider nearest neighbor within 0.25 m; accuracy not certified"
            },
            "preserved": "All rows, float64 decoded XYZ, original structured records, native classes, IDs, edge/dead flags and official train/test membership",
            "limitations": [
              "Class 0 is not assumed reliable background",
              "No article-specific evaluator is implemented",
              "One acquisition area does not establish geographic transfer",
              "Use both reference and channel masks; unavailable values remain native"
            ],
            "evidence": [
              "https://zenodo.org/records/19351234",
              "https://github.com/ruoppa/fgi_emit",
              "metadata.yaml with SHA256 e8891b43eb0d6ca3b649a61ff79ce50a3e0bc0c6b93e14a1e5c1de09d55a482b"
            ]
          }
        },
        "unmatched_split_rows": {
          "maxItems": 0
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "record_id",
            "archives"
          ],
          "properties": {
            "record_id": {
              "const": 19351234
            },
            "archives": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "sha256",
                  "provider_checksum"
                ],
                "properties": {
                  "name": {
                    "enum": [
                      "training.zip",
                      "test.zip"
                    ]
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "provider_checksum": {
                    "type": "string",
                    "pattern": "^md5:[0-9a-f]{32}$"
                  }
                }
              }
            }
          }
        },
        "scenes": {
          "items": {
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^19351234-[0-9a-f]{20}$"
              },
              "published_split": {
                "enum": [
                  "train",
                  "test"
                ]
              },
              "class_counts": {
                "minItems": 6,
                "maxItems": 6
              }
            }
          }
        }
      }
    }
  ]
}
